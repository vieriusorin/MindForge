# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

# graphify (local code graph; rebuild with `graphify update .`)
graphify-out/

# MF-0008: content pipeline cache (fetched docs, run reports); never committed
.cache/

# MF-0055: per-machine GitHub sync state for pnpm ticket:github
.planning/.github-sync.json
.planning/.github-sync.log
