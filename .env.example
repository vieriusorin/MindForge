# Supabase. Local values: `supabase status -o env`. The two NEXT_PUBLIC_ values are browser-safe; the
# secret key at the bottom is server-only (ADR 0004).
#   NEXT_PUBLIC_SUPABASE_URL            <- API_URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY <- PUBLISHABLE_KEY
# Never put a secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# MF-0004: the site origin used in emailed sign-in links and invite URLs (server-only, never
# derived from request headers). Optional locally (defaults to http://localhost:3001);
# REQUIRED in production, e.g. https://mindforge.vercel.app (no trailing path).
SITE_URL=

# ADR 0004 / MF-0011: the project's SECRET key (sb_secret_…), SERVER-ONLY. Used by
# src/server/supabase/secret.ts alone, for the group heatmap's cross-member read.
# Local: `pnpm dev:setup` writes it (supabase status SECRET_KEY). Never NEXT_PUBLIC_, never logged.
SUPABASE_SECRET_KEY=
