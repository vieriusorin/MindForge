# Supabase (public, browser-safe values only). Local values: `supabase status -o env`
#   NEXT_PUBLIC_SUPABASE_URL            <- API_URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY <- PUBLISHABLE_KEY
# Never add the secret / service-role key here or in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# MF-0004: the site origin used in emailed sign-in links and invite URLs (server-only, never
# derived from request headers). Optional locally (defaults to http://localhost:3001);
# REQUIRED in production, e.g. https://mindforge.vercel.app (no trailing path).
SITE_URL=
